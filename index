<!DOCTYPE html>
<html lang="uk">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0B0B12">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<title>DESIRE — студія танців у Києві</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;700&family=Manrope:wght@300;400;500;600;700&display=swap" rel="stylesheet">
<style>
:root{
  --ink:#0B0B12;
  --ink2:#14141F;
  --mist:#EDE9F5;
  --lav:#CDB9FF;
  --lime:#C8F751;
  --sky:#7AD7F0;
  --rose:#FF7A93;
  --sand:#F2D7A1;
  --gold:var(--lav);
  --coral:var(--rose);
  --peri:var(--lav);
  --mint:var(--sky);
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html{background:var(--ink)}
body{margin:0;background:var(--ink);color:#fff;font:500 17px/1.5 Manrope,system-ui,sans-serif;overflow-x:clip}
h1,h2,h3,.o{font-family:Oswald,"Arial Narrow",sans-serif;text-transform:uppercase;margin:0;line-height:.98;letter-spacing:.005em}
button{font:inherit;color:inherit;cursor:pointer;border:0;background:none}
:focus-visible{outline:3px solid var(--lav);outline-offset:3px}
.sc{position:fixed;inset:0;overflow:hidden;will-change:transform}
.sc.hid{visibility:hidden}
#s4{overflow-y:auto;overscroll-behavior:contain;touch-action:pan-y;-webkit-overflow-scrolling:touch}
html,body{height:100%;overflow:hidden;overscroll-behavior:none}
body{touch-action:none}
.hd{position:fixed;left:0;right:0;top:0;z-index:50;display:flex;justify-content:space-between;align-items:center;padding:calc(18px + env(safe-area-inset-top,0px)) 24px 0;color:#fff;transition:color .3s;pointer-events:none}
.hd>*{pointer-events:auto}
.hd.dk{color:var(--ink)}
.lg{font:700 26px Oswald,sans-serif;letter-spacing:.14em;text-decoration:none;color:inherit;text-shadow:0 2px 14px rgba(0,0,0,.5)}
.hd.dk .lg{text-shadow:none}
.pl{border:1.5px solid currentColor;border-radius:999px;padding:10px 20px;font:600 14px Manrope;color:inherit;text-decoration:none;background:rgba(11,11,18,.35);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px)}
.hd.dk .pl{background:transparent;backdrop-filter:none;-webkit-backdrop-filter:none}

/* НАВІГАЦІЯ */
.dots{
  position:fixed;
  z-index:60;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:4px;
  padding:6px 8px;
  border-radius:22px;
  background:rgba(20,20,31,.72);
  backdrop-filter:blur(22px) saturate(1.3);
  -webkit-backdrop-filter:blur(22px) saturate(1.3);
  border:1px solid rgba(205,185,255,.12);
  box-shadow:0 10px 30px rgba(0,0,0,.55);
}
.dots button{
  position:relative;
  flex:0 0 auto;
  display:flex;
  align-items:center;
  justify-content:center;
  width:52px;
  height:52px;
  padding:0;
  border-radius:16px;
  color:rgba(255,255,255,.55);
  background:transparent;
  transition:color .25s ease,background .25s ease,transform .15s ease;
  transform:none;
  pointer-events:auto;
  touch-action:manipulation;
}
.dots button:active{transform:scale(.94)}
.dots button .dot,
.dots button .dot svg,
.dots button .dot::before,
.dots button .dot::after,
.dots button .label{
  pointer-events:none;
}
.dots button .dot{
  width:22px;height:22px;
  flex:none;
  display:flex;align-items:center;justify-content:center;
  color:currentColor;
  position:relative;
  background:transparent;
  margin:0;
}
.dots button .dot svg{
  display:block;
  width:22px;height:22px;
  stroke:currentColor;fill:none;
  stroke-width:2;
  stroke-linecap:round;
  stroke-linejoin:round;
  transition:transform .25s ease;
}
.dots button .label{display:none}
.dots button.on{color:#0B0B12}
.dots button.on .dot svg{transform:scale(1.05)}
.dots button.on .dot::after{
  content:"";position:absolute;inset:-8px;border-radius:50%;
  background:var(--lime);
  z-index:-1;
  animation:popIn .3s ease both;
  box-shadow:0 0 0 4px rgba(200,247,81,.25);
}
@keyframes popIn{from{transform:scale(.55);opacity:0}to{transform:scale(1);opacity:1}}

.hd.dk ~ .dots{
  background:rgba(237,233,245,.82);
  border-color:rgba(11,11,18,.08);
  box-shadow:0 10px 30px rgba(11,11,18,.15);
}
.hd.dk ~ .dots button{color:rgba(11,11,18,.5)}
.hd.dk ~ .dots button.on{color:#fff}
.hd.dk ~ .dots button.on .dot::after{
  background:var(--ink);
  box-shadow:0 0 0 4px rgba(11,11,18,.15);
}

.dots{
  left:50%;right:auto;
  bottom:calc(16px + env(safe-area-inset-bottom,0px));
  top:auto;
  transform:translateX(-50%);
  flex-direction:row;
  width:auto;
  max-width:calc(100% - 32px);
}
@media (max-width:380px){
  .dots button{width:48px;height:50px}
  .dots button .dot svg{width:20px;height:20px}
}
@media (min-width:900px){
  .dots{
    left:auto;right:28px;
    top:50%;
    bottom:auto;
    transform:translateY(-50%);
    flex-direction:column;
    width:auto;
    max-width:none;
    gap:2px;
    padding:8px 6px;
    border-radius:26px;
  }
  .dots button{width:52px;height:52px;border-radius:18px}
}

/* scene transitions */
#s1{clip-path:ellipse(135% calc(var(--pi,0)*150%) at 50% 100%)}
#s2{clip-path:circle(calc(var(--pi,0)*88%) at 50% 55%)}
#s3{clip-path:inset(0 calc(50% * (1 - var(--pi,0))))}
#s4{clip-path:polygon(0 0,calc(var(--pi,0)*150%) 0,calc(var(--pi,0)*150% - 45%) 100%,0 100%)}
#s0{transform:scale(calc(1 - var(--po,0)*.1));border-radius:calc(var(--po,0)*48px)}
#s1{transform:translateY(calc(var(--po,0)*-14vh)) rotate(calc(var(--po,0)*-2.5deg))}
#s2{transform:scale(calc(1 + var(--po,0)*.07))}
#s3{transform:translateX(calc(var(--po,0)*-9vw)) scale(calc(1 - var(--po,0)*.05))}

/* hero */
#s0{background:#0B0B12;overflow:hidden}
.hero .bgimg{
  position:absolute;inset:0;
  width:100%;height:100%;
  object-fit:cover;object-position:center center;
  z-index:0;opacity:1;
}
.hero .tx,.hero .cue{z-index:2}
.hero h1{animation:up 1.3s .25s cubic-bezier(.2,.8,.2,1) both}
.hero p,.cue{animation:up 1.1s .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes up{from{opacity:0;transform:translateY(60px)}}
.hero .tx{position:absolute;left:0;right:0;bottom:0;padding:0 24px calc(34px + env(safe-area-inset-bottom,0px));display:flex;justify-content:space-between;align-items:flex-end;gap:20px}
.hero h1{font-size:clamp(88px,22vw,300px);font-weight:700;letter-spacing:.03em;line-height:.8;margin-left:-.04em;color:#fff;text-shadow:0 4px 24px rgba(0,0,0,.45)}
.hero p{margin:0 0 10px;text-align:right;font-size:15px;max-width:26ch;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.55)}
.cue{position:absolute;left:24px;bottom:calc(calc(34px + env(safe-area-inset-bottom,0px)) + clamp(88px,22vw,300px)*.9);font:600 12px Manrope;letter-spacing:.1em;text-transform:uppercase;display:flex;align-items:center;gap:12px;color:#fff;text-shadow:0 2px 12px rgba(0,0,0,.55)}
.cue i{width:44px;height:1px;background:#fff;transform-origin:left;animation:cu 2s ease-in-out infinite;box-shadow:0 0 8px rgba(0,0,0,.5)}
@keyframes cu{50%{transform:scaleX(.3)}}

/* manifesto */
#s1{background:var(--mist);color:var(--ink);padding:16vh 6vw 6vh;display:flex;flex-direction:column;justify-content:space-between}
.mf{font:500 clamp(30px,6.2vw,92px)/1.04 Oswald;text-transform:uppercase;max-width:18em}
.mf span{color:var(--ink)}
.mq{position:absolute;left:0;bottom:8vh;white-space:nowrap;font:700 clamp(120px,24vw,360px)/1 Oswald;color:transparent;-webkit-text-stroke:1.5px rgba(11,11,18,.2);pointer-events:none;will-change:transform}
.nm{position:relative;display:grid;grid-template-columns:repeat(3,1fr);gap:20px;border-top:1.5px solid var(--ink);padding-top:16px;max-width:900px}
.nm b{display:block;font:700 clamp(38px,6vw,76px)/1 Oswald;color:var(--ink)}
.nm span{font-size:14px;font-weight:600}
.mqi{display:inline-block;animation:mqm 36s linear infinite}@keyframes mqm{to{transform:translateX(-50%)}}

/* styles */
#s2{background:var(--ink)}
.sh{position:absolute;left:6vw;right:6vw;top:calc(12vh + env(safe-area-inset-top,0px));display:flex;justify-content:space-between;align-items:flex-end;gap:20px}
.sh h2{font-size:clamp(44px,8vw,110px);font-weight:700}
.ct{font:500 20px Oswald;letter-spacing:.08em;text-align:right;min-width:90px;color:var(--lav)}
.pg{position:absolute;left:6vw;right:6vw;bottom:5vh;height:2px;background:rgba(255,255,255,.15)}
.pg i{display:block;height:100%;background:var(--lav);width:0;transition:width .35s cubic-bezier(.22,1,.36,1)}
.tw{position:absolute;left:0;right:0;top:calc(26vh + env(safe-area-inset-top,0px));bottom:10vh;overflow:hidden}
.tk{display:flex;gap:20px;height:100%;padding:0 6vw;width:max-content;will-change:transform;transform:translate3d(0,0,0)}
.tk.anim{transition:transform .55s cubic-bezier(.19,1,.22,1)}
.tk.anim.fast{transition-duration:.42s}
.cd{position:relative;flex:none;width:min(78vw,500px);height:100%;border-radius:26px;padding:24px;color:var(--ink);display:flex;flex-direction:column;overflow:hidden;opacity:0;transform:translateX(70px)}
#s2.play .cd{opacity:1;transform:none;transition:opacity .8s,transform .9s cubic-bezier(.2,.8,.2,1);transition-delay:calc(var(--i,0)*90ms + .35s)}
.cd .n{font:500 18px Oswald;letter-spacing:.1em}
.cd h3{font-size:clamp(46px,8vw,92px);font-weight:700;margin:auto 0 10px;position:relative}
.cd .lv{display:inline-block;align-self:flex-start;border:1.5px solid var(--ink);border-radius:999px;padding:4px 12px;font-size:13px;font-weight:700;margin-bottom:10px;position:relative}
.cd p{margin:0 0 6px;font-size:15.5px;position:relative;max-width:30ch}
.cd small{font-size:13px;font-weight:700;opacity:.8;position:relative}
.cd .go{margin-top:14px;align-self:flex-start;background:var(--ink);color:#fff;border-radius:999px;padding:12px 22px;font-weight:700;font-size:14px;position:relative}
.orb{position:absolute;right:-20%;top:-8%;width:80%;aspect-ratio:1;border-radius:50%;border:2px solid rgba(11,11,18,.5);animation:spin 16s linear infinite}
.orb:before{content:"";position:absolute;inset:14%;border-radius:50%;border:2px dashed rgba(11,11,18,.45)}
.orb:after{content:"";position:absolute;left:50%;top:-8px;width:16px;height:16px;border-radius:50%;background:var(--ink)}
@keyframes spin{to{transform:rotate(360deg)}}

/* schedule — desktop */
#s3{background:var(--sand);color:var(--ink);padding:calc(12vh + env(safe-area-inset-top,0px)) 4vw 6vh;display:flex;flex-direction:column;gap:3vh}
.th{display:flex;justify-content:space-between;align-items:flex-end;gap:16px}
.th h2{font-size:clamp(40px,7vw,96px);font-weight:700}
.th p{margin:0;max-width:26ch;font-weight:600;text-align:right;font-size:15px}
.dc2{display:none;gap:8px;overflow-x:auto;scrollbar-width:none;-ms-overflow-style:none}
.dc2::-webkit-scrollbar{display:none}
.dc2 button{flex:none;min-height:44px;padding:0 16px;border:1.5px solid var(--ink);border-radius:999px;font-weight:700}
.dc2 button.on{background:var(--ink);color:var(--sand)}
.tt{display:grid;grid-template-columns:repeat(7,1fr);gap:10px;flex:1;min-height:0;align-content:start}
.dc h4{margin:0 0 8px;font:700 24px Oswald;text-transform:uppercase;display:flex;justify-content:space-between;align-items:baseline}
.dc h4.td::after{content:"сьогодні";font:700 10px Manrope;background:var(--ink);color:var(--lime);padding:2px 7px;border-radius:999px;text-transform:none}
.bk{position:relative;display:block;width:100%;text-align:left;background:var(--ink);color:#fff;border-radius:12px;padding:12px 12px 12px 18px;margin-bottom:8px;transition:transform .2s,opacity .5s}
.bk:hover{transform:translateY(-4px)}
.bk:before{content:"";position:absolute;left:0;top:10px;bottom:10px;width:5px;border-radius:0 4px 4px 0;background:var(--c)}
.bk b{display:block;font:500 24px Oswald;line-height:1}
.bk span{display:block;font-size:13.5px;font-weight:700;margin-top:2px}
.bk small{font-size:12px;opacity:.75;font-weight:500}
.bk.sel{outline:3px solid var(--lime);outline-offset:2px}

/* booking */
#s4{background:var(--lav);color:var(--ink);padding:calc(14vh + env(safe-area-inset-top,0px)) 6vw 40px;display:flex;flex-direction:column;justify-content:space-between;gap:30px}
.bg{display:grid;grid-template-columns:1.1fr 1fr;gap:5vw;align-items:center}
.bg h2{font-size:clamp(50px,9vw,130px);font-weight:700}
.bg p{max-width:30ch;font-size:18px;font-weight:600;margin:18px 0 0}
.fm{background:var(--ink);color:#fff;border-radius:26px;padding:26px}
.fm label{display:block;font-weight:700;font-size:14px;margin:0 0 6px}

/* Кастомний select */
.cselect{position:relative;margin-bottom:14px;user-select:none}
.cselect-btn{
  width:100%;
  min-height:52px;
  display:flex;align-items:center;justify-content:space-between;
  gap:12px;
  padding:0 16px;
  font:inherit;
  font-size:16px;
  color:#fff;
  background:rgba(255,255,255,.06);
  border:1.5px solid rgba(255,255,255,.14);
  border-radius:12px;
  text-align:left;
  transition:border-color .2s,background .2s,box-shadow .2s;
}
.cselect-btn:hover{background:rgba(255,255,255,.09)}
.cselect.open .cselect-btn,
.cselect-btn:focus-visible{
  border-color:var(--lime);
  background:rgba(255,255,255,.09);
  box-shadow:0 0 0 4px rgba(200,247,81,.15);
  outline:none;
}
.cselect-btn .txt{
  flex:1;
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.cselect-btn .arr{
  flex:none;
  width:18px;height:18px;
  display:flex;align-items:center;justify-content:center;
  color:rgba(255,255,255,.6);
  transition:transform .25s ease,color .2s;
}
.cselect.open .cselect-btn .arr{transform:rotate(180deg);color:var(--lime)}
.cselect-btn .arr svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:2.4;stroke-linecap:round;stroke-linejoin:round}

.cselect-menu{
  position:absolute;
  left:0;right:0;
  top:calc(100% + 8px);
  z-index:20;
  background:rgba(20,20,31,.96);
  backdrop-filter:blur(20px) saturate(1.4);
  -webkit-backdrop-filter:blur(20px) saturate(1.4);
  border:1px solid rgba(205,185,255,.18);
  border-radius:16px;
  box-shadow:0 24px 60px rgba(0,0,0,.55);
  padding:6px;
  max-height:280px;
  overflow-y:auto;
  overscroll-behavior:contain;
  -webkit-overflow-scrolling:touch;
  touch-action:pan-y;
  opacity:0;
  transform:translateY(-6px) scale(.98);
  pointer-events:none;
  transition:opacity .2s ease,transform .25s cubic-bezier(.2,.9,.2,1);
}
.cselect.open .cselect-menu{
  opacity:1;
  transform:none;
  pointer-events:auto;
}
.cselect-menu::-webkit-scrollbar{width:6px}
.cselect-menu::-webkit-scrollbar-thumb{background:rgba(205,185,255,.3);border-radius:3px}

.cselect-opt{
  display:flex;align-items:center;gap:12px;
  padding:12px 14px;
  border-radius:12px;
  font-size:15px;
  font-weight:600;
  color:rgba(255,255,255,.85);
  cursor:pointer;
  transition:background .15s,color .15s;
  position:relative;
}
.cselect-opt:hover{background:rgba(205,185,255,.1);color:#fff}
.cselect-opt.sel{
  background:var(--lime);
  color:var(--ink);
}
.cselect-opt.sel .dot-mark{background:var(--ink)}
.cselect-opt .dot-mark{
  flex:none;
  width:8px;height:8px;border-radius:50%;
  background:var(--lav);
  transition:background .2s,transform .2s;
}
.cselect-opt.sel .dot-mark{transform:scale(1.2)}
.cselect-opt .txt{
  flex:1;
  min-width:0;
  overflow:hidden;
  text-overflow:ellipsis;
  white-space:nowrap;
}
.cselect-opt .chk{
  flex:none;
  width:18px;height:18px;
  display:flex;align-items:center;justify-content:center;
  opacity:0;
  color:var(--ink);
}
.cselect-opt.sel .chk{opacity:1}
.cselect-opt .chk svg{width:14px;height:14px;stroke:currentColor;fill:none;stroke-width:3;stroke-linecap:round;stroke-linejoin:round}

.cselect-opt.consult .dot-mark{background:var(--rose)}
.cselect-opt.consult.sel{background:var(--rose);color:#fff}
.cselect-opt.consult.sel .dot-mark{background:#fff}
.cselect-opt.consult.sel .chk{color:#fff}

.fm input{
  width:100%;
  min-height:52px;
  font:inherit;
  font-size:16px;
  color:#fff;
  background:rgba(255,255,255,.06);
  border:1.5px solid rgba(255,255,255,.14);
  border-radius:12px;
  padding:0 16px;
  margin-bottom:14px;
  transition:border-color .2s,background .2s,box-shadow .2s;
}
.fm input:focus{
  outline:none;
  border-color:var(--lime);
  background:rgba(255,255,255,.09);
  box-shadow:0 0 0 4px rgba(200,247,81,.15);
}
.fm .sub{
  width:100%;
  min-height:56px;
  background:var(--lime);
  color:var(--ink);
  border-radius:12px;
  font:700 15px Manrope;
  letter-spacing:.06em;
  text-transform:uppercase;
  margin-top:6px;
  transition:transform .15s,box-shadow .25s;
}
.fm .sub:hover{box-shadow:0 12px 30px rgba(200,247,81,.25)}
.fm .sub:active{transform:scale(.98)}
#ok{
  display:none;
  margin-top:14px;
  background:var(--lime);
  color:var(--ink);
  border-radius:12px;
  padding:14px;
  font-weight:700;
}
.ft{display:flex;justify-content:space-between;flex-wrap:wrap;gap:8px;font-size:14px;font-weight:700;border-top:1.5px solid var(--ink);padding-top:14px}

/* MOBILE */
@media (max-width:899px){

  body{font-size:16px;-webkit-font-smoothing:antialiased}
  .sc{position:fixed;inset:0}

  .hd{padding:calc(12px + env(safe-area-inset-top,0px)) 20px 0}
  .lg{font-size:20px;letter-spacing:.2em}
  .pl{padding:8px 14px;font-size:12.5px;background:rgba(11,11,18,.4);backdrop-filter:blur(10px);color:#fff}
  .hd.dk .pl{color:var(--ink);background:transparent}

  #s0{background:#0B0B12}
  .hero .bgimg{object-position:center center;opacity:1}

  .hero .tx{display:block;padding:0 20px calc(140px + env(safe-area-inset-bottom,0px))}
  .hero h1{font-size:clamp(72px,22vw,160px);margin:0 0 8px;line-height:.82;letter-spacing:.02em}
  .hero p{display:block;text-align:left;font-size:13.5px;font-weight:500;max-width:22ch;margin:0;opacity:.9;line-height:1.4}
  .cue{left:20px;bottom:calc(56px + env(safe-area-inset-bottom,0px));font-size:10px;letter-spacing:.18em}
  .cue i{width:36px}

  #s1{
    padding:calc(9vh + env(safe-area-inset-top,0px)) 22px calc(130px + env(safe-area-inset-bottom,0px));
    justify-content:flex-start;gap:20px;
    display:flex;flex-direction:column;
  }
  .mf{font-size:clamp(24px,7vw,38px);line-height:1.08;font-weight:500;max-width:none;margin-bottom:6px}
  .nm{
    display:grid;grid-template-columns:1fr;gap:0;
    border-top:1px solid rgba(11,11,18,.15);
    padding:0;margin-top:0;
  }
  .nm > div{
    display:flex;align-items:center;justify-content:space-between;
    gap:16px;padding:16px 0;border-bottom:1px solid rgba(11,11,18,.1);
  }
  .nm > div:last-child{border-bottom:0}
  .nm b{font-size:42px;line-height:1;letter-spacing:-.01em}
  .nm span{font-size:13px;font-weight:600;opacity:.7;text-align:right;max-width:16ch}
  .mq{bottom:calc(100px + env(safe-area-inset-bottom,0px));font-size:clamp(90px,32vw,180px);opacity:.4}

  #s2{padding:0;background:var(--ink);display:flex;flex-direction:column}
  .sh{
    flex:none;padding:calc(11vh + env(safe-area-inset-top,0px)) 22px 0;
    flex-direction:row;align-items:baseline;justify-content:space-between;gap:12px;
  }
  .sh h2{font-size:clamp(40px,12vw,64px);letter-spacing:.01em}
