</section>

<div class="cselect-backdrop" id="cselectBackdrop"></div>

<script>
var $=function(i){return document.getElementById(i)};

var ST={h:['Хіп-хоп','#CDB9FF','Грув, ізоляції та перша зв\'язка вже на першому занятті.'],l:['Латина','#C8F751','Сальса, бачата й трохи реггетону. Партнер не потрібен.'],c:['Контемп','#7AD7F0','Дихання, вага тіла, підлога. Танець, який можна відчути.'],j:['Джаз-фанк','#FF7A93','Різкі лінії, вайб і хореографія під улюблені треки.'],s:['Стретчинг','#F2D7A1','М\'яке розтягнення без змагань і порівнянь.']},
DAYS=['Пн','Вт','Ср','Чт','Пт','Сб','Нд'],
TT=[[['h','19:00','початківці'],['c','20:30','середній']],[['l','19:00','початківці'],['s','20:30','усі рівні']],[['h','19:00','початківці'],['j','20:30','початківці']],[['c','19:00','початківці'],['l','20:30','середній']],[['j','19:00','середній'],['h','20:30','середній']],[['h','12:00','відкрите'],['l','14:00','початківці'],['s','16:00','усі рівні']],[['c','12:00','початківці'],['s','14:00','усі рівні']]],
LV={h:'Для початківців',l:'Усі рівні',c:'Початківці й середній',j:'Початківці',s:'Усі рівні'};

var ICONS=[
 '<svg viewBox="0 0 24 24"><path d="M4 11 12 4l8 7"/><path d="M6 10v10h12V10"/></svg>',
 '<svg viewBox="0 0 24 24"><path d="M5 6h14M5 11h14M5 16h9"/></svg>',
 '<svg viewBox="0 0 24 24"><path d="M12 3.5l2.6 5.6 6 .8-4.4 4.2 1.1 6L12 17.4 6.7 20l1.1-6L3.4 9.9l6-.8L12 3.5Z"/></svg>',
 '<svg viewBox="0 0 24 24"><rect x="4" y="6" width="16" height="15" rx="2"/><path d="M16 3v4M8 3v4M4 11h16"/></svg>',
 '<svg viewBox="0 0 24 24"><path d="M12 20s-7-4.4-7-9.3A4.2 4.2 0 0 1 12 7.8a4.2 4.2 0 0 1 7 2.9C19 15.6 12 20 12 20Z"/></svg>'
];

function pluralZanyat(n){
  var n10=n%10,n100=n%100;
  if(n10===1&&n100!==11)return 'заняття';
  if(n10>=2&&n10<=4&&(n100<10||n100>=20))return 'заняття';
  return 'занять';
}

var words='Ми не вчимо ідеальних рухів. Ми допомагаємо знайти свій такт: у тілі, у музиці, у кімнаті, де нікого не соромно.'.split(' ');
$('mf').innerHTML=words.map(function(w,i){return '<span style="--i:'+i+'">'+w+'</span>'}).join(' ');

var counters=[{n:12},{n:7},{n:150}];
var nmEl=$('nm');
nmEl.innerHTML=counters.map(function(c){
 return '<div><b>0</b><span>'+(c.n===12?'людей у групі максимум':c.n===7?'днів на тиждень':'₴ перше заняття')+'</span></div>';
}).join('');
counters.forEach(function(c,i){c.el=nmEl.querySelectorAll('b')[i]});

var countersDone=false;
function ease(t){return t<.5?4*t*t*t:1-Math.pow(-2*t+2,3)/2}
function countUp(){
 counters.forEach(function(c){
  var T=c.n,t0=performance.now();
  (function f(n){
   var t=Math.min(1,Math.max(0,(n-t0)/1600));
   c.el.textContent=Math.round(T*ease(t));
   if(t<1)requestAnimationFrame(f);
  })(t0);
 });
}

var keys=Object.keys(ST);
$('tk').innerHTML=keys.map(function(k,i){
 var days=[];TT.forEach(function(d,di){if(d.some(function(x){return x[0]===k}))days.push(DAYS[di])});
 return '<div class="cd" style="background:'+ST[k][1]+';--i:'+i+'"><div class="orb"></div><div class="n">0'+(i+1)+'</div><h3>'+ST[k][0]+'</h3><span class="lv">'+LV[k]+'</span><p>'+ST[k][2]+'</p><small>'+days.join(', ')+'</small><button class="go" type="button" data-st="'+k+'">Записатися</button></div>';
}).join('');

var all=[],sel=null,curDay=(new Date().getDay()+6)%7;
TT.forEach(function(d,di){d.forEach(function(x,i){all.push({d:di,i:i,k:x[0],t:x[1],l:x[2]})})});

$('tt').innerHTML=TT.map(function(d,di){
 var label=d.length+' '+pluralZanyat(d.length);
 return '<div class="dc'+(di===curDay?' cur today':'')+'" data-d="'+di+'">'+
   '<h4 data-count="'+label+'">'+DAYS[di]+'</h4>'+
   d.map(function(x,i){
     return '<button type="button" class="bk" style="--c:'+ST[x[0]][1]+';--j:'+(di*3+i)+'" data-b="'+di+'-'+i+'">'+
       '<b>'+x[1]+'</b>'+
       '<span>'+ST[x[0]][0]+'</span>'+
       '<small>'+x[2]+'</small>'+
     '</button>';
   }).join('')+
 '</div>';
}).join('');

$('dc2').innerHTML=DAYS.map(function(d,i){return '<button type="button" class="'+(i===curDay?'on':'')+'" data-c="'+i+'">'+d+'</button>'}).join('');

var CONSULT_VALUE=-1;

var OPTIONS = [{value:CONSULT_VALUE,label:'Хочу просто проконсультуватись',consult:true}]
  .concat(all.map(function(a,j){
    return {value:j,label:DAYS[a.d]+' '+a.t+' · '+ST[a.k][0]+' ('+a.l+')'};
  }));

var cselect=$('cselect'),cselectBtn=$('cselectBtn'),cselectMenu=$('cselectMenu'),
    cselectTxt=$('cselectTxt'),cselectBackdrop=$('cselectBackdrop');

cselectMenu.innerHTML=OPTIONS.map(function(o){
 return '<div class="cselect-opt'+(o.consult?' consult':'')+'" role="option" data-val="'+o.value+'">'+
   '<span class="dot-mark"></span>'+
   '<span class="txt">'+o.label+'</span>'+
   '<span class="chk"><svg viewBox="0 0 24 24"><path d="M5 13l4 4 10-10"/></svg></span>'+
 '</div>';
}).join('');

var cselectOpen=false;
function isOpen(){return cselectOpen;}

function setSelectValue(val,label){
 sel=val;
 cselectTxt.textContent=label;
 cselectMenu.querySelectorAll('.cselect-opt').forEach(function(el){
   el.classList.toggle('sel',+el.dataset.val===val);
 });
 if(val!==CONSULT_VALUE){
  document.querySelectorAll('.bk').forEach(function(b){b.classList.toggle('sel',b.dataset.b===all[val].d+'-'+all[val].i)});
 }else{
  document.querySelectorAll('.bk').forEach(function(b){b.classList.remove('sel')});
 }
}

function openSelect(){
 cselect.classList.add('open');
 cselectBtn.setAttribute('aria-expanded','true');
 cselectBackdrop.classList.add('on');
 cselectOpen=true;
 document.body.style.overscrollBehavior='none';
 setTimeout(function(){
  var selEl=cselectMenu.querySelector('.cselect-opt.sel');
  if(selEl&&cselectMenu.scrollTo){
   var target=selEl.offsetTop-(cselectMenu.clientHeight-selEl.offsetHeight)/2;
   cselectMenu.scrollTo({top:Math.max(0,target),behavior:'smooth'});
  }
 },60);
}
function closeSelect(){
 cselect.classList.remove('open');
 cselectBtn.setAttribute('aria-expanded','false');
 cselectBackdrop.classList.remove('on');
 cselectOpen=false;
}

cselectBtn.addEventListener('click',function(e){
 e.stopPropagation();
 if(cselectOpen)closeSelect();else openSelect();
});
cselectBackdrop.addEventListener('click',closeSelect);

cselectMenu.addEventListener('click',function(e){
 var opt=e.target.closest('.cselect-opt');
 if(!opt)return;
 var val=+opt.dataset.val;
 var label=opt.querySelector('.txt').textContent;
 setSelectValue(val,label);
 closeSelect();
});

document.addEventListener('click',function(e){
 if(cselectOpen&&!e.target.closest('#cselect')&&!e.target.closest('#cselectBackdrop')){
  closeSelect();
 }
});
document.addEventListener('keydown',function(e){
 if(e.key==='Escape'&&cselectOpen)closeSelect();
});

var todayIdx=all.findIndex(function(a){return a.d===curDay});
var initIdx=todayIdx>=0?todayIdx:0;
setSelectValue(initIdx,OPTIONS[initIdx+1].label);

document.querySelectorAll('.bk').forEach(function(b){
 b.addEventListener('click',function(){
   var p=b.dataset.b.split('-');
   var j=all.findIndex(function(a){return a.d===+p[0]&&a.i===+p[1]});
   if(j>=0)setSelectValue(j,OPTIONS[j+1].label);
 });
});
document.querySelectorAll('[data-st]').forEach(function(g){
 g.addEventListener('click',function(){
   var j=all.findIndex(function(a){return a.k===g.dataset.st});
   if(j>=0)setSelectValue(j,OPTIONS[j+1].label);
 });
});

var track=$('tk'),cards=document.querySelectorAll('.cd'),stepW=0,over=0,maxStep=0,stp=0;

function measure(){
 if(innerWidth<900)return;
 var c=cards[0]; if(!c) return;
 var gap=parseFloat(getComputedStyle(track).gap)||20;
 stepW=c.offsetWidth+gap;
 over=Math.max(0,track.scrollWidth-innerWidth);
 maxStep=stepW?Math.ceil(over/stepW):0;
 stp=Math.min(stp,maxStep);
 applyStep(true);
}
function applyStep(inst){
 if(innerWidth<900){track.style.transform='';return}
 if(inst)track.classList.remove('anim','fast');else track.classList.add('anim');
 track.style.transform='translate3d('+(-Math.min(stp*stepW,over))+'px,0,0)';
 $('ct').textContent=String(stp+1).padStart(2,'0')+' / '+String(maxStep+1).padStart(2,'0');
 $('pgb').style.width=(maxStep?stp/maxStep*100:100)+'%';
}
function stepTo(n,fast){
 if(innerWidth<900){busy=false;return}
 n=Math.max(0,Math.min(maxStep,n));
 if(n===stp){busy=false;return}
 stp=n;
 track.classList.toggle('fast',!!fast);
 applyStep(false);
 busy=true;unlock(fast?420:560);
}

var dayTabs=$('dc2'),dayCols=document.querySelectorAll('.dc');
function setDay(d){
 curDay=d;
 dayCols.forEach(function(col){col.classList.toggle('cur',+col.dataset.d===d)});
 dayTabs.querySelectorAll('button').forEach(function(b){b.classList.toggle('on',+b.dataset.c===d)});
 var active=dayTabs.querySelector('button.on');
 if(active&&dayTabs.scrollTo){
  var left=active.offsetLeft-(dayTabs.clientWidth-active.offsetWidth)/2;
  dayTabs.scrollTo({left:Math.max(0,left),behavior:'smooth'});
 }
 stp=0;over=0;maxStep=0;
 track.classList.remove('anim','fast');
 track.style.transform='translate3d(0,0,0)';
 void track.offsetWidth;
 busy=false;
 measure();
}

$('send').onclick=function(){
 var n=$('n').value.trim(),p=$('p').value.trim(),o=$('ok');
 o.style.display='block';
 if(!n||!p){
  o.textContent='Вкажіть ім\'я та телефон, щоб ми підтвердили запис.';
  return;
 }
 if(sel===CONSULT_VALUE){
  o.textContent=n+', дякуємо! Ми зв\'яжемося з вами, щоб підібрати напрямок і час.';
 }else{
  var a=all[sel];
  o.textContent=n+', ви записані: '+DAYS[a.d]+' '+a.t+', '+ST[a.k][0]+'. Напишемо для підтвердження.';
 }
};

var sc=[].slice.call(document.querySelectorAll('.sc')),N=sc.length,cur=0,busy=false,
 rm=matchMedia('(prefers-reduced-motion:reduce)').matches,
 dk=[0,1,0,1,1];
var DUR=1200;

function setV(k,pi,po){
 var s=sc[k];
 s.style.setProperty('--pi',pi.toFixed(4));
 s.style.setProperty('--po',po.toFixed(4));
 s.classList.toggle('hid',pi<=.001);
}
function norm(t){sc.forEach(function(s,k){setV(k,k<=t?1:0,k<t?1:0);s.classList.toggle('play',k<=t)})}
function tween(fn,dur,done){
 var t0=performance.now();
 (function f(n){
  var t=Math.min(1,Math.max(0,(n-t0)/dur));
  fn(ease(t));
  if(t<1)requestAnimationFrame(f);else if(done)done();
 })(t0);
}
function theme(t){
 $('hd').classList.toggle('dk',!!dk[t]);
 document.querySelectorAll('#dots button').forEach(function(b,i){b.classList.toggle('on',i===t)});
}
function unlock(ms){setTimeout(function(){busy=false},ms)}

function goTo(t,fast){
 if(busy||t===cur||t<0||t>=N)return;
 busy=true;
 var c=cur,fwd=t>c,dur=fast?720:DUR;
 function fin(){cur=t;norm(t);unlock(320)}
 if(fwd){
  for(var k=c+1;k<t;k++)setV(k,0,0);
  if(t===2){stp=0;measure()}
  setV(t,0,0);
  setTimeout(function(){sc[t].classList.add('play')},dur*.5);
  tween(function(e){setV(t,e,0);setV(c,1,e)},dur,fin);
 }else{
  for(var k2=t+1;k2<c;k2++)setV(k2,0,0);
  if(t===2){stp=maxStep;applyStep(true)}
  tween(function(e){setV(c,1-e,0);setV(t,1,1-e)},dur,fin);
 }
 setTimeout(function(){theme(t);if(t===1&&!countersDone){countersDone=true;countUp()}},dur*.45);
}
function next(){
 if(busy)return;
 if(isOpen())return;
 if(cur===2&&stp<maxStep&&innerWidth>=900)return stepTo(stp+1,true);
 goTo(cur+1);
}
function prev(){
 if(busy)return;
 if(isOpen())return;
 if(cur===2&&stp>0&&innerWidth>=900)return stepTo(stp-1,true);
 goTo(cur-1);
}
function go(i,fast){
 if(rm)return $('s'+i).scrollIntoView({behavior:fast?'auto':'smooth'});
 goTo(i,fast);
}

var SECTION_NAMES=['Головна','Маніфест','Напрямки','Розклад','Запис'];
$('dots').innerHTML=sc.map(function(_,i){
 return '<button type="button" data-g="'+i+'" aria-label="'+SECTION_NAMES[i]+'">'+
        '<span class="dot">'+ICONS[i]+'</span>'+
        '<span class="label">'+SECTION_NAMES[i]+'</span>'+
        '</button>';
}).join('');

$('dots').addEventListener('click',function(e){
 var b=e.target.closest('[data-g]');
 if(!b)return;
 e.preventDefault();
 e.stopPropagation();
 var idx=+b.dataset.g;
 if(busy){
  setTimeout(function(){busy=false;go(idx,true)},180);
  return;
 }
 go(idx,true);
},true);

$('hb').onclick=function(e){e.preventDefault();go(4,true)};
$('lg').onclick=function(e){e.preventDefault();go(0,true)};

document.addEventListener('click',function(e){
 if(e.target.closest('.dots')||e.target.closest('#cselect')||e.target.closest('#cselectBackdrop'))return;
 var b=e.target.closest('.bk');
 if(b){go(4);return}
 var g=e.target.closest('[data-st]');
 if(g){go(4);return}
 var c=e.target.closest('[data-c]');
 if(c){setDay(+c.dataset.c);return}
});

if(rm){
 document.documentElement.classList.add('rm');
 counters.forEach(function(c){c.el.textContent=c.n});
}else{
 sc.forEach(function(s,k){s.style.zIndex=k+1});
 norm(0);theme(0);measure();

 var lastW=0,s4=$('s4');
 addEventListener('resize',function(){measure();if(innerWidth<900){stp=0;track.classList.remove('anim','fast');track.style.transform=''}});

 var twEl=document.querySelector('.tw');
 var ttEl=document.querySelector('.tt');

 function scrollBox(target){
  if(!target)return null;
  if(twEl&&twEl.contains(target))return twEl;
  if(ttEl&&ttEl.contains(target))return ttEl;
  return null;
 }
 function canScroll(box,dir){
  if(!box)return false;
  var max=box.scrollHeight-box.clientHeight;
  if(max<=1)return false;
  if(dir>0)return box.scrollTop<max-1;
  if(dir<0)return box.scrollTop>1;
  return true;
 }

 addEventListener('wheel',function(e){
  if(isOpen()){
   if(e.target.closest('#cselectMenu')){
    var menu=cselectMenu;
    var dir=e.deltaY>0?1:-1;
    var max=menu.scrollHeight-menu.clientHeight;
    if((dir>0&&menu.scrollTop>=max-1)||(dir<0&&menu.scrollTop<=1)){
     e.preventDefault();
    }
    return;
   }
   e.preventDefault();
   return;
  }

  var now=performance.now(),gap=now-lastW;lastW=now;
  if(busy){e.preventDefault();return}
  if(Math.abs(e.deltaY)<3)return;

  if(innerWidth<900){
   var box=scrollBox(e.target);
   if(box){
    var dir2=e.deltaY>0?1:-1;
    if(canScroll(box,dir2))return;
    e.preventDefault();
    if(gap<70)return;
    dir2>0?next():prev();
    return;
   }
  }

  if(cur===N-1){if(e.deltaY>0)return;if(s4.scrollTop>0)return}
  e.preventDefault();
  if(gap<70)return;
  e.deltaY>0?next():prev();
 },{passive:false});

 var ty=0,tx=0,ts=0;
 addEventListener('touchstart',function(e){
  ty=e.touches[0].clientY;tx=e.touches[0].clientX;ts=s4.scrollTop;
 },{passive:true});
 addEventListener('touchmove',function(e){
  if(isOpen()){
   if(!e.target.closest('#cselectMenu')){
    e.preventDefault();
   }
   return;
  }
  if(innerWidth<900){
   var box=scrollBox(e.target);
   if(box)return;
  }
  if(cur!==N-1)e.preventDefault();
 },{passive:false});
 addEventListener('touchend',function(e){
  if(isOpen())return;

  var dy=e.changedTouches[0].clientY-ty,dx=e.changedTouches[0].clientX-tx;

  if(innerWidth<900){
   var box=scrollBox(e.target);
   if(box){
    if(Math.abs(dy)<48)return;
    var dir=dy<0?1:-1;
    if(canScroll(box,dir))return;
    dir>0?next():prev();
    return;
   }
  }

  if(cur===2&&innerWidth>=900&&Math.abs(dx)>48&&Math.abs(dx)>Math.abs(dy)){
   if(busy)return;
   if(dx<0&&stp<maxStep)stepTo(stp+1,true);
   else if(dx>0&&stp>0)stepTo(stp-1,true);
   return;
  }
  if(Math.abs(dy)<48)return;
  if(cur===N-1){if(dy>48&&ts<=0&&s4.scrollTop<=0)prev();return}
  dy<0?next():prev();
 },{passive:true});

 addEventListener('keydown',function(e){
  if(isOpen()){
   if(e.key==='Escape'){closeSelect();e.preventDefault();return}
   if(e.key==='ArrowDown'||e.key==='ArrowUp'){
    e.preventDefault();
    var opts=Array.prototype.slice.call(cselectMenu.querySelectorAll('.cselect-opt'));
    var idx=opts.findIndex(function(o){return o.classList.contains('sel')});
    var dir=(e.key==='ArrowDown')?1:-1;
    var nextIdx=Math.max(0,Math.min(opts.length-1,(idx>=0?idx:0)+dir));
    var el=opts[nextIdx];
    if(el){
     opts.forEach(function(o){o.classList.remove('sel')});
     el.classList.add('sel');
     setSelectValue(+el.dataset.val,el.querySelector('.txt').textContent);
     el.scrollIntoView({block:'nearest',behavior:'smooth'});
    }
    return;
   }
   if(e.key==='Enter'){
    e.preventDefault();
    closeSelect();
    return;
   }
   return;
  }

  if(e.target.closest&&e.target.closest('input,select,textarea,button'))return;
  var k=e.key;
  if(k==='ArrowDown'||k==='PageDown'||k===' '){
   e.preventDefault();
   if(cur===N-1)s4.scrollBy({top:90,behavior:'smooth'});else next();
  }else if(k==='ArrowUp'||k==='PageUp'){
   e.preventDefault();
   if(cur===N-1&&s4.scrollTop>0)s4.scrollBy({top:-90,behavior:'smooth'});else prev();
  }else if(k==='ArrowRight'&&cur===2&&!busy&&stp<maxStep)stepTo(stp+1,true);
  else if(k==='ArrowLeft'&&cur===2&&!busy&&stp>0)stepTo(stp-1,true);
 });
}
</script>
</body>
</html>
